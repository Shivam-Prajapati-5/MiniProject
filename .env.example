# Copy this file to .env and fill in your own values.
# Never commit .env or reuse the placeholder JWT secret in production.

PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/nexchat
JWT_SECRET=change-me
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Optional frontend build-time values for split hosting. Set these in
# frontend/.env or the build environment; Vite does not read the root .env.
# VITE_API_URL=/api
# VITE_SOCKET_URL=
