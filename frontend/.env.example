# Vercel build-time values. Set these in the Vercel project settings
# (Production and Preview as needed), then redeploy.
#
# The API is called through the Vercel same-origin proxy configured in
# vercel.json, so the browser keeps using /api and the auth cookie stays
# first-party. VITE_SOCKET_URL points at the Render backend because the
# Socket.IO handshake does not use the proxied cookie; it uses a
# short-lived socket token from /api/auth/socket-token instead.
VITE_API_URL=/api
VITE_SOCKET_URL=https://YOUR_BACKEND_URL.onrender.com

# Server-side Vercel variable used by vercel.json (not exposed to the browser):
# BACKEND_URL=https://YOUR_BACKEND_URL.onrender.com
